{
  "productName": "Thingary Windows Acceptance",
  "identifier": "local.thingary.win.acceptance",
  "build": {
    "beforeBuildCommand": "npm run build && node scripts/prepare-windows.mjs --identity local.thingary.win.acceptance"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "物谱 · Windows 验收",
        "width": 1600,
        "height": 1000,
        "center": true,
        "minWidth": 800,
        "minHeight": 600,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--remote-debugging-address=127.0.0.1 --remote-debugging-port=9227"
      }
    ]
  },
  "bundle": {
    "resources": {
      "../.local/distribution/windows-notices/": "许可/"
    }
  }
}
