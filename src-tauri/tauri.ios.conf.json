{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "mobile.html",
        "title": "物谱 · 开发预览",
        "width": 390,
        "height": 844,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "iOS": {
      "minimumSystemVersion": "16.0",
      "frameworks": [
        "LocalAuthentication",
        "PhotosUI",
        "WebKit",
        "UserNotifications",
        "ImageIO",
        "UniformTypeIdentifiers",
        "Foundation"
      ]
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0"
  }
}
